# Copy to .env or .env.local and adjust as needed.

# --- Server-side ---

# GonkaRouter API Configuration (https://gonkarouter.io)
GONKAROUTER_API_KEY=your_gonkarouter_api_key_here
GONKAROUTER_BASE_URL=https://api.gonkarouter.io/v1
GONKAROUTER_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731

# Tavily Real-Time Web Search API (https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# Server-side Base RPC used by the Thetanuts SDK.
BASE_RPC_URL=https://mainnet.base.org

# Base-mainnet policy accounts use the real Thetanuts OptionBook and USDC.
# The same dedicated agent key signs risk/quote attestations and may deploy this
# factory. It is never a personal wallet key and should hold only minimal gas ETH.
NEXT_PUBLIC_BASE_MANDATE_FACTORY_ADDRESS=
NEXT_PUBLIC_BASE_AGENT_ADDRESS=
BASE_MANDATE_FACTORY_DEPLOYMENT_BLOCK=
BASE_AGENT_PRIVATE_KEY=
BASE_AGENT_CRON_SECRET=
BASE_AGENT_URL=http://localhost:3000
BASE_AGENT_INTERVAL_SECONDS=15
BASE_AGENT_STATE_PATH=.base-agent/state.json
# Keep true until a deliberate real-money activation; only false broadcasts.
BASE_AGENT_DRY_RUN=true

# Disabled by default: RFQs escrow collateral and require a separately audited
# execution flow. Do not enable for the hackathon demo.
ENABLE_RFQ_EXECUTION=false

# Base Sepolia shadow contracts. The signer attests short-lived test quotes;
# it never holds user collateral and must remain server-side.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
SHADOW_OPTION_BOOK_ADDRESS=
SHADOW_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
SHADOW_CHAIN_ID=84532
SHADOW_QUOTE_SIGNER_PRIVATE_KEY=
SHADOW_DEPLOYMENT_BLOCK=
# Optional: RPC used only to scan for receipt tx hashes (10,000-block eth_getLogs
# chunks). Defaults to the public Base Sepolia RPC above. Set this if
# BASE_SEPOLIA_RPC_URL points at a metered provider whose free tier caps
# eth_getLogs far tighter than its normal rate limit (e.g. Alchemy's free plan
# allows only a 10-block range, which would silently blank every receipt link).
SHADOW_LOGS_RPC_URL=

# Base Sepolia ERC-4337 policy-account factory. This public address may be
# exposed to the browser; it contains no credentials or user funds.
NEXT_PUBLIC_BASE_SEPOLIA_MANDATE_FACTORY_ADDRESS=0x9f28d2e723cf59d5b6a7d3a0db0bbbb49540d6ee
NEXT_PUBLIC_BASE_SEPOLIA_SHADOW_OPTION_BOOK_ADDRESS=0x6090e5Dd4987dce186DcB9d5fb8Fc24776A67bB3
NEXT_PUBLIC_BASE_SEPOLIA_SHADOW_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
NEXT_PUBLIC_BASE_SEPOLIA_AGENT_ADDRESS=0x28863e85e2c50953F06a690ae14013A59089eaaE
BASE_SEPOLIA_MANDATE_FACTORY_DEPLOYMENT_BLOCK=46175938

# Coinbase Exchange WebSocket ticker feed (lib/stream.ts).
COINBASE_WS_URL=wss://ws-feed.exchange.coinbase.com

# Coinbase Exchange REST API for candles (app/api/klines).
COINBASE_API_URL=https://api.exchange.coinbase.com

# Binance public market-data mirror, candle fallback (app/api/klines).
BINANCE_API_URL=https://data-api.binance.vision

# Pimlico Bundler API Key
PIMLICO_API_KEY=pim_

# Bearer secret for the scheduled/manual shadow agent request. Generate using openssl rand -hex 32
SHADOW_AGENT_CRON_SECRET=

# Run `npm run agent:shadow` in one persistent external worker. This local
# journal is not a database; mount it on persistent storage for restart-safe
# pending UserOperation tracking.
SHADOW_AGENT_URL=http://localhost:3000
SHADOW_AGENT_INTERVAL_SECONDS=15
SHADOW_AGENT_STATE_PATH=.shadow-agent/state.json

# --- Client-side (NEXT_PUBLIC_* is inlined at build time; restart dev server) ---

# Block explorer for "View on BaseScan" links (components/WalletConnect.tsx).
NEXT_PUBLIC_BASE_EXPLORER_URL=https://basescan.org

# Must be true together with ENABLE_RFQ_EXECUTION to show RFQ actions.
NEXT_PUBLIC_ENABLE_RFQ_EXECUTION=false

# Block explorer for GammaShield's test-only shadow fill.
NEXT_PUBLIC_BASE_SEPOLIA_EXPLORER_URL=https://sepolia-explorer.base.org
