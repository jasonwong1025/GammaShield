# Copy to .env or .env.local and adjust as needed.

# --- Server-side ---

# GonkaRouter API Configuration (https://gonkarouter.io)
GONKAROUTER_API_KEY=your_gonkarouter_api_key_here
GONKAROUTER_BASE_URL=https://api.gonkarouter.io/v1
GONKAROUTER_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731

# Server-side Base RPC used by the Thetanuts SDK.
BASE_RPC_URL=https://mainnet.base.org

# Base Sepolia shadow contracts. The signer attests short-lived test quotes;
# it never holds user collateral and must remain server-side.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
SHADOW_OPTION_BOOK_ADDRESS=
SHADOW_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
SHADOW_CHAIN_ID=84532
SHADOW_QUOTE_SIGNER_PRIVATE_KEY=
SHADOW_DEPLOYMENT_BLOCK=

# Coinbase Exchange WebSocket ticker feed (lib/stream.ts).
COINBASE_WS_URL=wss://ws-feed.exchange.coinbase.com

# Coinbase Exchange REST API for candles (app/api/klines).
COINBASE_API_URL=https://api.exchange.coinbase.com

# Binance public market-data mirror, candle fallback (app/api/klines).
BINANCE_API_URL=https://data-api.binance.vision

# --- Client-side (NEXT_PUBLIC_* is inlined at build time; restart dev server) ---

# Block explorer for "View on BaseScan" links (components/WalletConnect.tsx).
NEXT_PUBLIC_BASE_EXPLORER_URL=https://basescan.org

# Block explorer for GammaShield's test-only shadow fill.
NEXT_PUBLIC_BASE_SEPOLIA_EXPLORER_URL=https://sepolia-explorer.base.org
